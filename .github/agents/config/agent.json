{
  "$comment": "DSA agent configuration. Every key is documented in .github/agents/README.md. Values marked (env) can be overridden per run with the given environment variable / GitHub repository variable.",

  "language": "python",
  "timezone": "UTC",
  "lessonsDir": "dsa",

  "problemsPerDay": 5,
  "maxProblemsPerDay": 8,
  "defaultDifficulty": "progressive",
  "minTestsPerProblem": 6,
  "maxRepairAttempts": 3,

  "revision": {
    "enabled": true,
    "intervalsInDays": [7, 21, 45],
    "minNewLessonsBetweenRevisions": 2
  },

  "ai": {
    "provider": "auto",
    "models": {
      "openai": "gpt-5",
      "anthropic": "claude-sonnet-5-5",
      "gemini": "gemini-3.8-flash"
    },
    "baseUrls": {
      "openai": "https://api.openai.com/v1",
      "anthropic": "https://api.anthropic.com",
      "gemini": "https://generativelanguage.googleapis.com/v1beta"
    },
    "fallbackModels": {
      "gemini": ["gemini-3.5-flash", "gemini-3.1-flash-lite"]
    },
    "geminiThinkingLevel": "low",
    "temperature": null,
    "maxOutputTokens": 24000,
    "requestTimeoutSeconds": 600,
    "maxAttempts": 4
  },

  "sandbox": {
    "mode": "docker",
    "timeoutSeconds": 120,
    "memory": "512m",
    "cpus": "1",
    "pidsLimit": 128
  }
}
